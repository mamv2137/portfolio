---
import Layout from '../layouts/Layout.astro';
import Dashboard from '@/components/dashboard/Dashboard.astro';
import BootOverlay from '@/components/boot/BootOverlay';
import '@/styles/globals.css'
---

<script is:inline>
	const getThemePreference = () => {
		if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
			return localStorage.getItem('theme');
		}
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	};
	const isDark = getThemePreference() === 'dark';
	document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

	const getMotionPreference = () => {
		if (typeof localStorage !== 'undefined' && localStorage.getItem('tui:motion')) {
			return localStorage.getItem('tui:motion');
		}
		return window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'off' : 'on';
	};
	const motionOff = getMotionPreference() === 'off';
	document.documentElement.classList[motionOff ? 'add' : 'remove']('motion-off');

	const getCrtPreference = () => {
		if (typeof localStorage !== 'undefined') {
			return localStorage.getItem('tui:crt') === 'on';
		}
		return false;
	};
	document.documentElement.classList[getCrtPreference() ? 'add' : 'remove']('crt-on');

	const VALID_THEMES = ['catppuccin', 'monokai', 'dracula', 'nord', 'tokyo-night'];
	const getThemePalette = () => {
		if (typeof localStorage !== 'undefined') {
			const stored = localStorage.getItem('tui:theme');
			if (stored && VALID_THEMES.indexOf(stored) !== -1) return stored;
		}
		return 'catppuccin';
	};
	document.documentElement.setAttribute('data-theme', getThemePalette());

	const VALID_LANGS = ['en', 'es'];
	const getLangPreference = () => {
		if (typeof localStorage !== 'undefined') {
			const stored = localStorage.getItem('tui:lang');
			if (stored && VALID_LANGS.indexOf(stored) !== -1) return stored;
		}
		return (navigator.language || 'en').toLowerCase().startsWith('es') ? 'es' : 'en';
	};
	document.documentElement.setAttribute('data-lang', getLangPreference());

	if (typeof localStorage !== 'undefined') {
		const observer = new MutationObserver(() => {
			const root = document.documentElement;
			localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
			localStorage.setItem('tui:motion', root.classList.contains('motion-off') ? 'off' : 'on');
			localStorage.setItem('tui:crt', root.classList.contains('crt-on') ? 'on' : 'off');
			const t = root.getAttribute('data-theme');
			if (t) localStorage.setItem('tui:theme', t);
			const l = root.getAttribute('data-lang');
			if (l) localStorage.setItem('tui:lang', l);
		});
		observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme', 'data-lang'] });
	}
</script>

<Layout title="mauro@portfolio:~$">
	<Dashboard />
	<BootOverlay client:load />
</Layout>

<script>
  import { IDLE_TITLES } from '@/content/idle';

  const originalTitle = document.title;
  let timer: number | null = null;

  const rand = (min: number, max: number) => Math.random() * (max - min) + min;

  const pickIdle = (prev: string): string => {
    let next = IDLE_TITLES[Math.floor(Math.random() * IDLE_TITLES.length)];
    let guard = 0;
    while (next === prev && guard < 4) {
      next = IDLE_TITLES[Math.floor(Math.random() * IDLE_TITLES.length)];
      guard++;
    }
    return next;
  };

  const stop = () => {
    if (timer !== null) {
      window.clearTimeout(timer);
      timer = null;
    }
  };

  const tick = () => {
    if (document.visibilityState === 'visible') return;
    document.title = pickIdle(document.title);
    timer = window.setTimeout(tick, rand(2000, 4000));
  };

  const onVisibilityChange = () => {
    if (document.documentElement.classList.contains('motion-off')) {
      document.title = originalTitle;
      stop();
      return;
    }
    if (document.visibilityState === 'visible') {
      document.title = originalTitle;
      stop();
    } else {
      stop();
      document.title = pickIdle('');
      timer = window.setTimeout(tick, rand(2000, 4000));
    }
  };

  document.addEventListener('visibilitychange', onVisibilityChange);

  // also restore on focus / clean up on pagehide
  window.addEventListener('focus', () => {
    document.title = originalTitle;
    stop();
  });
  window.addEventListener('pagehide', stop);
</script>
