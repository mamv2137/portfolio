---
export interface Props {
  en: string;
  es: string;
  as?: 'span' | 'p' | 'div' | 'strong' | 'em';
  class?: string;
}

const { en, es, as: Tag = 'span', class: className = '' } = Astro.props;
---

<Tag class={className}>
  <span data-lang="en">{en}</span><span data-lang="es">{es}</span>
</Tag>
