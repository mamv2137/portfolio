---
import HeaderBar from './HeaderBar.astro';
import FooterStatusBar from './FooterStatusBar.astro';
import AboutPanel from './AboutPanel.astro';
import SkillsPanel from './SkillsPanel.astro';
import ExperiencePanel from './ExperiencePanel.astro';
import ProjectsPanel from './ProjectsPanel.astro';
import ContactPanel from './ContactPanel.astro';
import ActivityPanel from './ActivityPanel.astro';
import CrtOverlay from '@/components/tui/CrtOverlay.astro';
---

<div class="min-h-screen flex flex-col bg-tui-bg text-tui-fg font-tui">
  <HeaderBar />

  <main class="flex-1 px-3 sm:px-5 py-5">
    <div
      class="grid gap-4 sm:gap-5 max-w-[1400px] mx-auto"
      style="grid-template-columns: repeat(1, minmax(0, 1fr));"
    >
      <div class="md:col-span-2 lg:col-span-3">
        <AboutPanel />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 md:col-span-2 lg:col-span-3">
        <SkillsPanel />
        <ExperiencePanel />
        <ActivityPanel />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 md:col-span-2 lg:col-span-3">
        <ProjectsPanel />
        <ContactPanel />
      </div>
    </div>
  </main>

  <FooterStatusBar />
  <CrtOverlay />
</div>
