---
import { identity, bio } from '@/content/profile';
import HeaderTagline from './HeaderTagline';
import Clock from './Clock';
---

<header
  class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-tui-border bg-tui-bg-elev px-3 py-2 font-tui text-sm"
>
  <span class="text-tui-accent">
    {identity.user}@{identity.host}
  </span>
  <span class="text-tui-muted">:</span>
  <span class="text-tui-info">{identity.path}</span>
  <span class="text-tui-accent">$</span>

  <span class="ml-1 text-tui-fg min-w-0 flex-1 truncate">
    <HeaderTagline client:idle en={bio.taglines.en} es={bio.taglines.es} />
  </span>

  <span class="ml-auto inline-flex items-center gap-3 text-xs">
    <span class="hidden sm:inline-flex items-center gap-1 text-tui-muted">
      <span aria-hidden="true">{'⛃'}</span>
      <span class="text-tui-fg">{identity.branch}</span>
    </span>
    <Clock client:load />
  </span>
</header>
