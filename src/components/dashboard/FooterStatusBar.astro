---
import StatusBar from '@/components/tui/StatusBar.astro';
import ThemePicker from '@/components/tui/ThemePicker';
import { identity } from '@/content/profile';
---

<footer class="sticky bottom-0 z-10" aria-label="status">
  <StatusBar
    segments={[
      { label: 'theme', value: '◐ dark', tone: 'accent', id: 'seg-theme' },
      { label: 'lang', value: 'en', tone: 'info', id: 'seg-lang' },
      { label: 'motion', value: 'on', tone: 'info', id: 'seg-motion', hideOnMobile: true },
      { label: 'crt', value: 'off', tone: 'muted', id: 'seg-crt', hideOnMobile: true },
      { label: 'branch', value: identity.branch, tone: 'muted', hideOnMobile: true },
      { label: 'build', value: identity.version, tone: 'muted', hideOnMobile: true },
      { value: '[ t ] light/dark', tone: 'accent', id: 'hint-theme' },
      { value: '[ l ] lang', tone: 'accent', id: 'hint-lang' },
      { value: '[ m ] motion', tone: 'accent', id: 'hint-motion' },
      { value: '[ c ] crt', tone: 'accent', id: 'hint-crt' },
      { value: '[ ] ] palette', tone: 'accent', id: 'hint-palette' },
    ]}
  />
  <div class="flex items-center justify-end gap-3 border-t border-tui-border bg-tui-bg-elev px-3 py-1">
    <ThemePicker client:load />
  </div>
</footer>

<script>
  const root = document.documentElement;
  const VALID_THEMES = ['catppuccin', 'monokai', 'dracula', 'nord', 'tokyo-night'];

  const updateSegments = () => {
    const isDark = root.classList.contains('dark');
    const motionOff = root.classList.contains('motion-off');
    const crtOn = root.classList.contains('crt-on');
    const lang = root.getAttribute('data-lang') ?? 'en';

    const theme = document.querySelector('[data-segment="seg-theme"] > :last-child');
    if (theme) theme.textContent = isDark ? '◐ dark' : '◑ light';

    const langSeg = document.querySelector('[data-segment="seg-lang"] > :last-child');
    if (langSeg) langSeg.textContent = lang;

    const motion = document.querySelector('[data-segment="seg-motion"] > :last-child');
    if (motion) motion.textContent = motionOff ? 'off' : 'on';

    const crt = document.querySelector('[data-segment="seg-crt"] > :last-child');
    if (crt) crt.textContent = crtOn ? 'on' : 'off';
  };

  updateSegments();

  const obs = new MutationObserver(updateSegments);
  obs.observe(root, { attributes: true, attributeFilter: ['class', 'data-theme'] });

  const cyclePalette = (direction: number) => {
    const current = root.getAttribute('data-theme') ?? 'catppuccin';
    const idx = VALID_THEMES.indexOf(current);
    const next = VALID_THEMES[(idx + direction + VALID_THEMES.length) % VALID_THEMES.length];
    root.setAttribute('data-theme', next);
  };

  const toggleLang = () => {
    const current = root.getAttribute('data-lang') === 'es' ? 'es' : 'en';
    root.setAttribute('data-lang', current === 'en' ? 'es' : 'en');
  };

  const isTypingTarget = (el: EventTarget | null) => {
    if (!(el instanceof HTMLElement)) return false;
    const tag = el.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return true;
    if (el.isContentEditable) return true;
    return false;
  };

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (isTypingTarget(e.target)) return;
    const k = e.key.toLowerCase();
    if (k === 't') {
      e.preventDefault();
      root.classList.toggle('dark');
    } else if (k === 'm') {
      e.preventDefault();
      root.classList.toggle('motion-off');
    } else if (k === 'c') {
      e.preventDefault();
      root.classList.toggle('crt-on');
    } else if (k === 'l') {
      e.preventDefault();
      toggleLang();
    } else if (e.key === ']') {
      e.preventDefault();
      cyclePalette(1);
    } else if (e.key === '[') {
      e.preventDefault();
      cyclePalette(-1);
    }
  });

  const wireToggle = (id: string, cls: string) => {
    const el = document.querySelector(`[data-segment="${id}"]`);
    if (!el) return;
    el.setAttribute('role', 'button');
    el.setAttribute('tabindex', '0');
    el.classList.add('cursor-pointer', 'hover:text-tui-accent');
    el.addEventListener('click', () => root.classList.toggle(cls));
    el.addEventListener('keydown', (ev) => {
      const ke = ev as KeyboardEvent;
      if (ke.key === 'Enter' || ke.key === ' ') {
        ev.preventDefault();
        root.classList.toggle(cls);
      }
    });
  };
  wireToggle('hint-theme', 'dark');
  wireToggle('hint-motion', 'motion-off');
  wireToggle('hint-crt', 'crt-on');
  wireToggle('seg-theme', 'dark');
  wireToggle('seg-motion', 'motion-off');
  wireToggle('seg-crt', 'crt-on');

  const wireCustom = (id: string, handler: () => void) => {
    const el = document.querySelector(`[data-segment="${id}"]`);
    if (!el) return;
    el.setAttribute('role', 'button');
    el.setAttribute('tabindex', '0');
    el.classList.add('cursor-pointer', 'hover:text-tui-accent');
    el.addEventListener('click', handler);
    el.addEventListener('keydown', (ev) => {
      const ke = ev as KeyboardEvent;
      if (ke.key === 'Enter' || ke.key === ' ') {
        ev.preventDefault();
        handler();
      }
    });
  };
  wireCustom('hint-palette', () => cyclePalette(1));
  wireCustom('hint-lang', toggleLang);
  wireCustom('seg-lang', toggleLang);
</script>
