---
import Panel from '@/components/tui/Panel.astro';
import T from '@/components/tui/T.astro';
import { bio } from '@/content/profile';

const portrait = [
  '   ▄▀▀▀▀▀▀▀▀▀▀▄   ',
  '  █  ▄▄    ▄▄  █  ',
  '  █  ██    ██  █  ',
  '  █   ▀    ▀   █  ',
  '  █    ▄▀▀▄    █  ',
  '  █    ▀▀▀▀    █  ',
  '   ▀▄▄▄▄▄▄▄▄▄▄▀   ',
  '    █▀▀▀▀▀▀▀█     ',
  '    █       █     ',
];
---

<Panel title="~/about.md" hint="[ a ] about">
  <div class="flex gap-4 items-start">
    <div class="shrink-0 hidden sm:block border border-tui-border p-2 bg-tui-bg">
      <pre
        class="font-tui text-[10px] leading-[1.1] text-tui-accent select-none"
        aria-label={`portrait of ${bio.name}`}
      >{portrait.join('\n')}</pre>
      <p class="font-tui text-[10px] text-tui-muted text-center mt-1" aria-hidden="true">~/avatar.txt</p>
    </div>
    <div class="flex-1 min-w-0 space-y-3">
      <div>
        <p class="font-tui text-lg text-tui-fg">
          <T en={bio.greeting.en} es={bio.greeting.es} />
        </p>
        <p class="font-tui text-xs text-tui-muted">
          <T en={bio.subgreeting.en} es={bio.subgreeting.es} />
        </p>
      </div>
      <p class="font-tui text-sm text-tui-fg leading-relaxed">
        <T en={bio.paragraph.en} es={bio.paragraph.es} />
      </p>
      <dl
        class="grid grid-cols-1 sm:grid-cols-2 gap-2"
        aria-label="profile meta"
      >
        {bio.meta.map((m) => (
          <div class="border border-tui-border bg-tui-bg-elev/40 px-3 py-2 flex flex-col gap-[2px]">
            <dt class="font-tui text-[10px] text-tui-muted uppercase tracking-wide">
              <T en={m.label.en} es={m.label.es} />
            </dt>
            <dd class="font-tui text-sm text-tui-fg leading-tight">
              <T en={m.value.en} es={m.value.es} />
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</Panel>
