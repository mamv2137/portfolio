---
import Panel from '@/components/tui/Panel.astro';
import List from '@/components/tui/List.astro';
import ListItem from '@/components/tui/ListItem.astro';
import T from '@/components/tui/T.astro';
import { experience } from '@/content/profile';
---

<Panel title="~/experience.tsx" hint="[ e ] experience">
  <List ariaLabel="experience entries">
    {experience.map((entry, i) => (
      <ListItem selected={i === 0} meta={entry.range}>
        <div class="flex flex-col">
          <span class="text-tui-fg">
            <span class="text-tui-accent">{entry.role}</span>
            <span class="text-tui-muted"> · </span>
            <span>{entry.company}</span>
          </span>
          <span class="text-tui-muted text-xs">
            <T en={entry.summary.en} es={entry.summary.es} />
          </span>
        </div>
      </ListItem>
    ))}
  </List>
</Panel>
